# 轉寫服務（選填）：groq、openai 或 windows。
# 不填時：有 GROQ_API_KEY 就用 groq；否則有 OPENAI_API_KEY 就用 openai；
# 否則在 Windows 上用 windows（內建離線辨識，需要 ffmpeg，不加標點、準確度較低）；以上都不符合則拒絕啟動。
TRANSCRIBE_PROVIDER=

# Groq API 金鑰（建議，有免費額度）。到 https://console.groq.com/keys 申請，gsk_ 開頭。
# 只放在後端，絕不放進前端。
GROQ_API_KEY=

# Groq 轉寫模型（選填，預設 whisper-large-v3-turbo）。
GROQ_TRANSCRIBE_MODEL=

# Groq LLM 模型（選填，預設 openai/gpt-oss-120b），給 /ai/summary 與 /ai/todos 使用。
# AI 一律走 Groq：沒有 GROQ_API_KEY 時伺服器照常啟動，但這兩個端點回 503 ai_unavailable。
GROQ_LLM_MODEL=

# OpenAI API 金鑰（不用 Groq 時才需要；模型固定 gpt-4o-mini-transcribe）。只放在後端，絕不放進前端。
OPENAI_API_KEY=

# ffmpeg 執行檔路徑（選填，只有 windows provider 使用；不填就用 PATH 上的 ffmpeg）。
FFMPEG_PATH=

# 存取金鑰（必填），逗號分隔；前端「設定」頁填的就是其中一把。
# 刻意留空：沒填之前伺服器拒絕啟動，避免範例值被當成正式金鑰。
# 每把請用至少 16 字元的隨機值：錯誤金鑰的嘗試不受限流，短金鑰可被線上猜中（較短仍可啟動，但會警告）。
# 產生方式：node -e "console.log(crypto.randomUUID())"
ACCESS_KEYS=

# CORS 允許來源（選填），逗號分隔；不填則用以下預設值。
# 正式環境請加上網頁正式網域，例如 https://notes.example.com
# 每項只能是 scheme://host[:port]，不可加路徑或結尾斜線（https://notes.example.com/ 會拒絕啟動）。
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost,app://bundle

# 監聽埠（選填，預設 8787）
PORT=8787
